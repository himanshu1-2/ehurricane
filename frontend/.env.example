# Copy to .env and fill in real values.

REACT_APP_STRIPE_KEY=
REACT_APP_BACKEND_URL='http://localhost:5003'

# Firebase Cloud Messaging — single source of truth (read by src/firebase.js,
# then forwarded to public/firebase-messaging-sw.js via query string).
# Get these from Firebase Console > Project settings > Your apps > Web app.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN='tiffian-mangement.firebaseapp.com'
REACT_APP_FIREBASE_PROJECT_ID='tiffian-mangement'
REACT_APP_FIREBASE_STORAGE_BUCKET='tiffian-mangement.appspot.com'
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Cloud Messaging > Web Push certificates > Key pair
REACT_APP_FIREBASE_VAPID_KEY=
